{
  "name": "yivi-frontend-packages",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "yivi-core",
    "yivi-css",
    "yivi-frontend",
    "plugins/*"
  ],
  "browserslist": [
    "> 0.25%",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "fmt": "eslint . --fix",
    "lint-js": "eslint .",
    "lint-css": "stylelint yivi-css/src/",
    "lint": "npm run lint-js && npm run lint-css",
    "build:core": "npm run build -w yivi-core",
    "build:plugins": "npm run build -w @privacybydesign/yivi-client -w @privacybydesign/yivi-web -w @privacybydesign/yivi-dummy -w @privacybydesign/yivi-console",
    "build:popup": "npm run build -w @privacybydesign/yivi-popup",
    "build:frontend": "npm run build -w @privacybydesign/yivi-frontend",
    "build:css": "npm run build -w yivi-css --if-present",
    "build": "npm run build:css && npm run build:core && npm run build:plugins && npm run build:popup && npm run build:frontend",
    "dev": "npm run dev --workspaces --if-present",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "multi-semantic-release --deps.bump=override --deps.release=patch",
    "release:dry": "multi-semantic-release --deps.bump=override --deps.release=patch --dry-run"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.3.0",
    "multi-semantic-release": "^3.0.2",
    "neostandard": "^0.13.0",
    "prettier": "3.9.1",
    "semantic-release": "^25.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.0",
    "stylelint-scss": "^7.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9",
    "webpack": "^5.76.3",
    "webpack-cli": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/privacybydesign/yivi-frontend-packages"
  }
}
