{
  "name": "@privacybydesign/yivi-popup",
  "version": "1.0.0-beta.5",
  "description": "A front-end plugin to show the Yivi form in a popup",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "release": "npm run build",
    "dev": "tsdown --watch"
  },
  "license": "SEE LICENSE IN REPOSITORY",
  "dependencies": {
    "@privacybydesign/yivi-core": "^1.0.0-beta.5",
    "@privacybydesign/yivi-web": "^1.0.0-beta.5",
    "deepmerge": "^4.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/privacybydesign/yivi-frontend-packages",
    "directory": "plugins/yivi-popup"
  }
}
